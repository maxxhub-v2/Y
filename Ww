            Rotation = 90,
            Parent = btn
        })

        -- Hover / Press — all buttons glow solid gold
        btn.MouseEnter:Connect(function()
            Tween(btn, 0.3, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out, {
                Size = UDim2.new(size.X.Scale, size.X.Offset + 6, size.Y.Scale, size.Y.Offset + 2),
