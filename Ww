        })
        Create("UICorner", {CornerRadius = UDim.new(0, 14), Parent = btn})

        -- Thick bright gold border — fully visible
        local stroke = Create("UIStroke", {
            Color = accent,
            Transparency = 0,
            Thickness = isPrimary and 2.8 or 2.2,
            Parent = btn
        })

